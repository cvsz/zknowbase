# Bootstrap/root key used to provision scoped service keys. Replace before production.
ZKB_API_KEY=change-me-long-random-secret
ZKB_BOOTSTRAP_API_KEY_ENABLED=true

# Next.js server-side proxy credential. Initially it may equal the bootstrap key;
# after provisioning, replace it with a service key scoped to knowledge:read/write.
ZKB_FRONTEND_API_KEY=change-me-long-random-secret
ZKB_FRONTEND_ORIGIN=http://localhost:3000
ZKB_QDRANT_URL=http://qdrant:6333
ZKB_QDRANT_COLLECTION=zknowbase
ZKB_METADATA_DB=/data/zknowbase.db
ZKB_UPLOAD_DIR=/data/uploads
ZKB_MAX_UPLOAD_MB=25
ZKB_CHUNK_SIZE=1000
ZKB_CHUNK_OVERLAP=150

# Local-first defaults
ZKB_EMBEDDING_PROVIDER=ollama
ZKB_EMBEDDING_MODEL=nomic-embed-text
ZKB_LLM_PROVIDER=ollama
ZKB_LLM_MODEL=qwen2.5:3b
ZKB_OLLAMA_BASE_URL=http://ollama:11434

# Cloud alternatives
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ZKB_OPENAI_BASE_URL=https://api.openai.com/v1

# Next.js server-side proxy only; never expose API keys via NEXT_PUBLIC_*.
ZKB_BACKEND_URL=http://backend:8000
