# Bootstrap/root key used to provision scoped service keys. Replace before production.
ZKB_API_KEY=change-me-long-random-secret
ZKB_BOOTSTRAP_API_KEY_ENABLED=true
# Existing service keys are mapped to this tenant when tenant binding is first observed.
# Use a stable lowercase tenant identifier; changing it later does not rewrite persisted mappings.
ZKB_DEFAULT_TENANT_ID=default

# Next.js server-side proxy credential. Initially it may equal the bootstrap key;
# after provisioning, replace it with a service key scoped to knowledge:read/write.
ZKB_FRONTEND_API_KEY=change-me-long-random-secret
ZKB_FRONTEND_ORIGIN=http://localhost:3000

# Local Admin UI human authentication. There are NO default credentials.
# Generate an admin entry from frontend/ without putting the password in argv:
#   read -rsp "Admin password: " PASS; printf '%s' "$PASS" | node scripts/hash-password.mjs admin admin
# Copy the generated ZKB_ADMIN_USERS_JSON='[...]' line here. Add a viewer by
# generating a second entry with role=viewer and combining both JSON objects.
ZKB_ADMIN_USERS_JSON=
# Generate with: openssl rand -hex 32
ZKB_ADMIN_SESSION_SECRET=
# Keep false for local http://localhost. Set true only when the Admin UI is served over HTTPS.
ZKB_ADMIN_COOKIE_SECURE=false

# Optional self-hosted OIDC login. Leave issuer empty to keep local auth only.
# Discovery, authorization, token and userinfo endpoints must stay on the issuer origin.
ZKB_OIDC_ISSUER=
ZKB_OIDC_CLIENT_ID=
ZKB_OIDC_CLIENT_SECRET=
ZKB_OIDC_REDIRECT_URI=http://localhost:3000/api/auth/oidc/callback
ZKB_OIDC_ROLE_CLAIM=groups
ZKB_OIDC_ADMIN_VALUE=zknowbase-admin
ZKB_OIDC_VIEWER_VALUE=zknowbase-viewer

ZKB_QDRANT_URL=http://qdrant:6333
ZKB_QDRANT_COLLECTION=zknowbase

# Zero-cost local-first metadata default.
ZKB_METADATA_BACKEND=sqlite
ZKB_METADATA_DB=/data/zknowbase.db

# Optional LOCAL Postgres HA profile. No managed/cloud database is required.
# To enable it, set ZKB_METADATA_BACKEND=postgres and run:
#   docker compose --profile ha up --build
# ZKB_POSTGRES_PASSWORD=replace-for-non-dev-use
# ZKB_POSTGRES_URL=postgresql://zknowbase:replace-for-non-dev-use@postgres:5432/zknowbase
ZKB_POSTGRES_POOL_MIN_SIZE=1
ZKB_POSTGRES_POOL_MAX_SIZE=10

ZKB_UPLOAD_DIR=/data/uploads
ZKB_MAX_UPLOAD_MB=25
ZKB_CHUNK_SIZE=1000
ZKB_CHUNK_OVERLAP=150

# Optional authenticated encryption for portable backup exports.
# Mount an owner-only file containing base64 of exactly 32 random bytes.
ZKB_BACKUP_ENCRYPTION_KEY_FILE=
ZKB_BACKUP_REQUIRE_ENCRYPTION=false

# Upload security is local and free. `validate` is the lightweight default and
# rejects malformed/active PDFs and invalid text before parsing. For local AV,
# set mode=clamav and start Compose with --profile security.
ZKB_MALWARE_SCAN_MODE=validate
ZKB_CLAMAV_HOST=clamav
ZKB_CLAMAV_PORT=3310
ZKB_CLAMAV_TIMEOUT_SECONDS=30

# Durable local ingestion queue/worker. No Redis/Celery/broker is required.
ZKB_WORKER_POLL_SECONDS=1.0
ZKB_WORKER_LEASE_SECONDS=300
ZKB_INGESTION_JOB_MAX_ATTEMPTS=3

# Local observability. Metrics are exposed on backend /metrics. To enable local
# OTLP traces run Compose with --profile observability; no cloud exporter is required.
ZKB_METRICS_ENABLED=true
ZKB_OTEL_SERVICE_NAME=zknowbase
ZKB_OTEL_EXPORTER_OTLP_ENDPOINT=
ZKB_OTEL_EXPORT_TIMEOUT_SECONDS=5
# Required by the observability profile; anonymous Grafana access is disabled.
# Generate/store this as an operator-controlled local secret, not in source control.
ZKB_GRAFANA_ADMIN_PASSWORD=

# Local-first / zero recurring API cost defaults.
ZKB_EMBEDDING_PROVIDER=ollama
ZKB_EMBEDDING_MODEL=nomic-embed-text
ZKB_LLM_PROVIDER=ollama
ZKB_LLM_MODEL=qwen2.5:3b
ZKB_OLLAMA_BASE_URL=http://ollama:11434

# Hybrid retrieval uses Qdrant dense candidates + dependency-free local BM25 reranking.
# Set dense to preserve the legacy dense-only ordering.
ZKB_RETRIEVAL_MODE=hybrid
ZKB_HYBRID_CANDIDATE_MULTIPLIER=4
ZKB_HYBRID_DENSE_WEIGHT=0.65

# Optional cloud adapters only. Leave empty to stay fully local/no API cost.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
ZKB_OPENAI_BASE_URL=https://api.openai.com/v1

# Next.js server-side proxy only; never expose API keys via NEXT_PUBLIC_*.
ZKB_BACKEND_URL=http://backend:8000
